---
import Icon from '../../components/Icon.astro';
import { normalizeTags } from '../../lib/tags';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { enrichWithStars } from '../../lib/github';

const base = import.meta.env.BASE_URL;

const projects = await getCollection('projects');
const projectsWithStars = await enrichWithStars(projects);

// 人工精选优先，避免研究项目因 Star 数盖过工程作品。
projectsWithStars.sort((a, b) => {
  if (a.data.featuredOrder !== b.data.featuredOrder) return a.data.featuredOrder - b.data.featuredOrder;
  return b.data.date.valueOf() - a.data.date.valueOf();
});
const categories = ['嵌入式开发', '深度学习', 'AI Agent 与工具', '研究项目'];
---

<BaseLayout title="项目展示" description="Tommie 的嵌入式开发、深度学习与 AI Agent 项目：查看技术栈、实现过程与公开源码。">
  <div class="mb-8">
    <p class="eyebrow">PROJECTS / 代码与实践</p>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-2 flex items-center gap-2">
      <Icon name="project" class="w-6 h-6" />
      项目展示
    </h1>
    <p class="text-gray-500 dark:text-gray-400">从嵌入式设备、深度学习到 AI 工具，记录问题、实现与工程取舍。</p>
  </div>

  {/* ⭐ 搜索栏 - 搜索图标 focus 变色 */}
  <div class="mb-6">
    <div class="relative group">
      <input
        type="text"
        id="search-input"
        aria-label="搜索项目" placeholder="搜索项目名称、技术栈…"
        class="w-full px-4 py-3 pl-10 paper-surface   border border-gray-200/50 dark:border-white/[0.06] rounded-xl text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 outline-none focus:border-garden-400 dark:focus:border-garden-500 focus:ring-2 focus:ring-garden-100/50 dark:focus:ring-garden-900/20 transition-[border-color,box-shadow]"
      />
      <svg class="absolute left-3 top-3.5 w-4 h-4 text-gray-400 dark:text-gray-500 group-focus-within:text-garden-500 dark:group-focus-within:text-garden-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    </div>
  </div>

  <div id="project-filter" class="project-filter" role="group" aria-label="按技术方向筛选">
    <button type="button" data-category="" aria-pressed="true">全部 <span>{projects.length}</span></button>
    {categories.map(category => <button type="button" data-category={category} aria-pressed="false">{category} <span>{projects.filter(p => p.data.category === category).length}</span></button>)}
  </div>
  <p id="project-count" class="project-result-count" role="status" aria-live="polite">共 {projects.length} 个项目</p>
  {projectsWithStars.length > 0 ? (
    <div class="grid sm:grid-cols-2 gap-5" id="projects-grid">
      {projectsWithStars.map((project) => (
        <div class="project-card" data-category={project.data.category} data-title={project.data.title.toLowerCase()} data-tech={normalizeTags(project.data.tech).join(' ').toLowerCase()} data-desc={project.data.description.toLowerCase()}>
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            tech={project.data.tech}
            link={project.data.link}
            github={project.data.github}
            image={project.data.image}
            date={project.data.date}
            slug={project.id.replace(/\.md$/, '')}
            stars={project.stars}
            category={project.data.category}
          />
        </div>
      ))}
    </div>
  ) : (
    <div class="text-center py-16">
      <img src={`${base}icons/项目.svg`} alt="" class="w-12 h-12 mx-auto mb-4 opacity-30 icon-colorful" />
      <p class="text-gray-400 dark:text-gray-500">还没有项目展示</p>
    </div>
  )}

  <!-- 搜索无结果提示 -->
  <div id="no-results" class="hidden text-center py-16">
    <p class="text-gray-400 dark:text-gray-500">没有找到匹配的项目</p>
  </div>
  <!-- 搜索逻辑已移至 BaseLayout 事件委托，无需内联脚本 -->
</BaseLayout>
