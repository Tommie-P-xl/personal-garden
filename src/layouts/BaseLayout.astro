---
import { ViewTransitions } from 'astro:transitions';
import Background from '../components/Background.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const { title, description = '个人数字花园 - 学习笔记与项目展示', wide = false } = Astro.props;
const containerClass = wide ? 'paper-main-wide' : 'max-w-5xl';
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

function href(path: string) {
  return base + path.replace(/^\//, '');
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <title>{title} | Tommie的花园</title>
    <link rel="stylesheet" href={href('/katex/katex.min.css')}>
    <ViewTransitions />
    <script is:inline>
      try {
        var theme = localStorage.getItem('theme') || 'system';
        var dark = theme === 'dark' || (theme === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
        document.documentElement.dataset.readingMode = localStorage.getItem('garden-reading-mode') === 'focus' ? 'focus' : 'default';
      } catch {}
    </script>
    <script>import '../scripts/site';</script>
  </head>
  <body class="paper-site min-h-screen relative">
    <a class="skip-link" href="#main-content">跳到正文</a>
    <Background />
    <Navbar base={base} currentPath={currentPath} />

    <!-- 主内容 -->
    <main id="main-content" tabindex="-1" class={`paper-main ${containerClass} mx-auto px-4 sm:px-6 py-8`} transition:animate="fade">
      <slot />
    </main>

    <Footer />
  </body>
</html>
