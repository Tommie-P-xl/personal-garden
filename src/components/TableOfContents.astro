---
interface Props {
  headings: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
}

const { headings } = Astro.props;

// 只显示 h2 和 h3
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{tocHeadings.length > 0 && (
  <>
    <!-- 桌面端固定 TOC -->
    <aside class="paper-toc hidden min-[1600px]:block w-44 flex-shrink-0">
      <nav class="sticky top-20 overflow-y-auto max-h-[calc(100vh-6rem)] pb-8 scrollbar-hide">
        <h4 class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-3">
          目录
        </h4>
        <ul class="space-y-1 border-l-2 border-gray-200 dark:border-gray-700/50">
          {tocHeadings.map((heading) => (
            <li>
              <a
                href={`#${heading.slug}`}
                class:list={[
                  'block py-1 text-sm transition-colors hover:text-garden-600 dark:hover:text-garden-400',
                  heading.depth === 2 ? 'pl-3 font-medium' : 'pl-6',
                  'text-gray-500 dark:text-gray-400',
                ]}
                data-toc-link={heading.slug}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>

    <!-- 移动端浮动按钮 -->
    <button
      id="toc-mobile-btn" title="本页章节"
      class="min-[1600px]:hidden fixed bottom-20 right-6 z-40 p-2.5 rounded-full shadow-lg
        paper-surface   border border-gray-200/50 dark:border-white/[0.06]
        text-gray-600 dark:text-gray-300 hover:bg-gray-100/60 dark:hover:bg-white/[0.06] transition-colors"
      aria-label="打开文章目录"
      aria-controls="toc-mobile-drawer"
      aria-expanded="false"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" />
      </svg>
    </button>

    <!-- 移动端抽屉 -->
    <div
      id="toc-mobile-overlay"
      class="min-[1600px]:hidden fixed inset-0 bg-black/50 z-40 hidden"
      aria-hidden="true"
    />
    <div
      id="toc-mobile-drawer" inert aria-hidden="true"
      class="paper-toc-drawer min-[1600px]:hidden fixed top-0 right-0 bottom-0 w-72 paper-surface   z-50 transform translate-x-full transition-transform overflow-y-auto border-l border-gray-200/50 dark:border-white/[0.06]"
      role="dialog"
      aria-modal="true"
      aria-label="文章目录"
      tabindex="-1"
    >
      <div class="p-4">
        <div class="flex items-center justify-between mb-4">
          <h4 class="text-sm font-semibold text-gray-900 dark:text-white">目录</h4>
          <button
            id="toc-mobile-close"
            type="button"
            aria-label="关闭目录"
            class="p-2 rounded-lg text-gray-600 dark:text-gray-300 hover:bg-gray-100/60 dark:hover:bg-white/[0.06]"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <ul class="space-y-1 border-l-2 border-gray-200 dark:border-gray-700/50">
          {tocHeadings.map((heading) => (
            <li>
              <a
                href={`#${heading.slug}`}
                class:list={[
                  'block py-1.5 text-sm transition-colors',
                  heading.depth === 2 ? 'pl-3 font-medium' : 'pl-6',
                  'text-gray-600 dark:text-gray-400 hover:text-garden-600 dark:hover:text-garden-400',
                ]}
                data-toc-link={heading.slug}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </>
)}

<script>
  let observer: IntersectionObserver | undefined;
  function highlight(slug: string) {
    document.querySelectorAll<HTMLElement>('[data-toc-link]').forEach(link => {
      if (link.dataset.tocLink === slug) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  }
  function initToc() {
    observer?.disconnect();
    const headings = Array.from(document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]'));
    if (!headings.length) return;
    const update = () => {
      const above = headings.filter(h => h.getBoundingClientRect().top <= 140);
      highlight((above.at(-1) || headings[0]).id);
    };
    observer = new IntersectionObserver(update, { rootMargin: '-80px 0px -65% 0px' });
    headings.forEach(h => observer!.observe(h));
    document.querySelectorAll<HTMLElement>('[data-toc-link]').forEach(link => {
      link.addEventListener('click', () => highlight(link.dataset.tocLink || ''));
    });
    update();
  }
  document.addEventListener('astro:before-swap', () => observer?.disconnect());
  document.addEventListener('astro:page-load', initToc);
  initToc();
</script>

<style>
  /* 隐藏滚动条但保持可滚动 */
  .scrollbar-hide {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;  /* Chrome, Safari and Opera */
  }
</style>
