---
import Icon from './Icon.astro';
import type { NoteFile } from '../lib/scan-notes';
import SidebarTree from './SidebarTree.astro';

interface Props {
  tree: NoteFile[];
  currentSlug: string;
  categoryTitle?: string;
}

const { tree, currentSlug, categoryTitle } = Astro.props;
const base = import.meta.env.BASE_URL;

---

{/* Desktop sidebar */}
<aside id="note-sidebar" class="paper-sidebar hidden xl:block w-56 flex-shrink-0">
  <nav class="sticky top-20 overflow-y-auto max-h-[calc(100vh-6rem)] pr-2 pb-8">
    <div class="space-y-1">
      {categoryTitle && (
        <div class="px-3 py-2 mb-1 flex items-center gap-2">
          <Icon name="note" class="w-4 h-4" />
          <span class="text-sm font-semibold text-gray-900 dark:text-white">{categoryTitle}</span>
        </div>
      )}
      <SidebarTree items={tree} currentSlug={currentSlug} />
    </div>
  </nav>
</aside>

{/* Mobile sidebar trigger */}
<button
  id="sidebar-toggle-btn" title="笔记目录"
  class="xl:hidden fixed bottom-6 right-6 z-40 p-3 rounded-full shadow-lg
    bg-garden-600 text-white hover:bg-garden-700 transition-colors"
  aria-label="打开笔记目录"
  aria-controls="sidebar-drawer"
  aria-expanded="false"
>
  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path>
  </svg>
</button>

{/* Mobile overlay */}
<div id="sidebar-overlay" class="xl:hidden fixed inset-0 bg-black/50 z-40 hidden" aria-hidden="true"></div>

{/* Mobile drawer */}
<div id="sidebar-drawer" inert aria-hidden="true" class="paper-drawer xl:hidden fixed top-0 left-0 bottom-0 w-72 paper-surface   z-50 transform -translate-x-full transition-transform overflow-y-auto border-r border-gray-200/50 dark:border-white/[0.06]" role="dialog" aria-modal="true" aria-label="笔记目录" tabindex="-1">
  <div class="p-4">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-white">目录</h2>
      <button id="sidebar-close-btn" type="button" aria-label="关闭目录" class="p-2 rounded-lg text-gray-600 dark:text-gray-300 hover:bg-gray-100/60 dark:hover:bg-white/[0.06]">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <nav class="space-y-1">
      {categoryTitle && (
        <div class="px-3 py-2 mb-1 flex items-center gap-2">
          <Icon name="note" class="w-4 h-4" />
          <span class="text-sm font-semibold text-gray-900 dark:text-white">{categoryTitle}</span>
        </div>
      )}
      <SidebarTree items={tree} currentSlug={currentSlug} />
    </nav>
  </div>
</div>

<script>
  function initSidebarTree() {
    let saved: string[] = [];
    try { saved = JSON.parse(localStorage.getItem('sidebar-open-slugs') || '[]'); } catch {}
    const open = new Set(Array.isArray(saved) ? saved : []);
    document.querySelectorAll<HTMLElement>('.sidebar-group').forEach(group => {
      if (group.querySelector('[aria-current="page"]')) open.add(group.dataset.slug || '');
    });
    document.querySelectorAll<HTMLButtonElement>('.sidebar-toggle').forEach(button => {
      const children = button.nextElementSibling;
      const slug = button.dataset.slug || '';
      function apply(isOpen: boolean) {
        children?.classList.toggle('hidden', !isOpen);
        button.querySelector('.chevron')?.classList.toggle('rotate-90', isOpen);
        button.setAttribute('aria-expanded', String(isOpen));
      }
      apply(open.has(slug));
      if (button.dataset.bound) return;
      button.dataset.bound = 'true';
      button.addEventListener('click', () => {
        const next = button.getAttribute('aria-expanded') !== 'true';
        apply(next);
        if (next) open.add(slug); else open.delete(slug);
        try { localStorage.setItem('sidebar-open-slugs', JSON.stringify([...open])); } catch {}
      });
    });
  }
  initSidebarTree();
  document.addEventListener('astro:page-load', initSidebarTree);
</script>
