---
// src/components/mdx/Image.astro
import { resolveMediaPath } from '../../lib/media-path';

interface Props {
  /** 图片源路径（相对于当前笔记的 _media 目录） */
  src: string;
  /** 替代文本 */
  alt?: string;
  /** 宽度 */
  width?: string;
  /** 高度 */
  height?: string;
  /** 对齐方式 */
  align?: 'left' | 'center' | 'right';
  /** 标题说明 */
  caption?: string;
}

const {
  src,
  alt = '',
  width,
  height,
  align = 'center',
  caption
} = Astro.props;

const base = import.meta.env.BASE_URL;

const processedSrc = resolveMediaPath(src, Astro.locals.noteSourceFile, base);

const sizeStyle = [
  width ? `width: ${width}` : '',
  height ? `height: ${height}` : '',
].filter(Boolean).join('; ');

const alignClasses = {
  left: 'image-align-left',
  center: 'image-align-center',
  right: 'image-align-right',
};
---

<figure class:list={['paper-image image-wrapper', alignClasses[align]]}>
  <img
    src={processedSrc}
    alt={alt}
    class="image-element"
    style={sizeStyle || undefined}
    loading="lazy"
  />
  {caption && <figcaption class="image-caption">{caption}</figcaption>}
</figure>

<style>
  .image-wrapper {
    @apply my-6;
  }

  .image-align-left {
    text-align: left;
  }

  .image-align-center {
    text-align: center;
  }

  .image-align-right {
    text-align: right;
  }

  .image-element {
    @apply rounded-lg shadow-md;
    max-width: 100%;
    height: auto;
    display: inline-block;
  }

  .image-align-left .image-element {
    display: block;
    margin-left: 0;
    margin-right: auto;
  }

  .image-align-center .image-element {
    display: block;
    margin-left: auto;
    margin-right: auto;
  }

  .image-align-right .image-element {
    display: block;
    margin-left: auto;
    margin-right: 0;
  }

  .image-caption {
    @apply text-sm text-gray-500 dark:text-gray-400 mt-2 italic;
  }

  .image-align-left .image-caption {
    text-align: left;
  }

  .image-align-center .image-caption {
    text-align: center;
  }

  .image-align-right .image-caption {
    text-align: right;
  }
</style>
