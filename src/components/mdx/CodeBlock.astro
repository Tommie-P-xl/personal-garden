---
interface Props {
  title?: string;
  language?: string;
  showLineNumbers?: boolean;
  highlightLines?: string;
}

const { title, language, showLineNumbers = false, highlightLines } = Astro.props;

// 解析高亮行号，如 "1,3-5" => [1, 3, 4, 5]
function parseHighlightLines(lines: string | undefined): number[] {
  if (!lines) return [];
  const result: number[] = [];
  lines.split(',').forEach((part) => {
    if (part.includes('-')) {
      const [start, end] = part.split('-').map(Number);
      for (let i = start; i <= end; i++) result.push(i);
    } else {
      result.push(Number(part));
    }
  });
  return result;
}

const highlightedLines = parseHighlightLines(highlightLines);
---

<div class="paper-codeblock my-4 rounded-lg border border-gray-200/60 dark:border-white/[0.06] overflow-hidden">
  {(title || language) && (
    <div class="paper-code-header flex items-center justify-between gap-3 px-4 py-2 bg-gray-100 dark:bg-gray-800 border-b border-gray-200/60 dark:border-white/[0.06]">
      {title && <span class="text-xs text-gray-600 dark:text-gray-300 font-mono truncate">{title}</span>}
      {language && <span class="paper-code-language text-[0.68rem] uppercase tracking-wider text-gray-500 dark:text-gray-400 font-mono">{language}</span>}
    </div>
  )}
  <div class="relative">
    {showLineNumbers && (
      <div class="absolute left-0 top-0 bottom-0 w-10 bg-gray-50 dark:bg-gray-800/50 border-r border-gray-200/60 dark:border-white/[0.06] select-none" />
    )}
    <div class="overflow-x-auto">
      <slot />
    </div>
  </div>
</div>
